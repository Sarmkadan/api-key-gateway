<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Test/benchmark assemblies are not published APIs, so XML doc generation (CS1591 etc.) does not apply. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <AssemblyName>api-key-gateway.Benchmarks</AssemblyName>
    <RootNamespace>ApiKeyGateway.Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ApiKeyGateway/ApiKeyGateway.csproj" />
  </ItemGroup>

</Project>
